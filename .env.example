# --- SETUP ---
# Copy this file to `.env` (`cp .env.example .env`) for local development.
#
# --- SECURITY WARNING ---
# NEVER commit `.env` to version control.
# The default values below are for LOCAL DEVELOPMENT ONLY. Generate strong,
# unique credentials for staging or production environments.
#
# --- SYNC RULE ---
# POSTGRES_* and DB_* values MUST stay in sync (same DB name, user, password).
#
# --- Docker Compose - PostgreSQL Container (REQUIRED - no fallback defaults) ---
POSTGRES_DB=mimi_db
POSTGRES_USER=mimi_user
POSTGRES_PASSWORD=mimi_pass
#
# --- Spring Boot Application - Datasource (OPTIONAL - falls back to application.yaml) ---
DB_URL=jdbc:postgresql://localhost:5432/mimi_db
DB_USERNAME=mimi_user
DB_PASSWORD=mimi_pass